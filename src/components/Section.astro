---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <h2 id={`${id}-title`} class="mb-8 text-2xl text-accent">
    <span aria-hidden="true" class="text-muted">~/</span>{title}
  </h2>
  <slot />
</section>
