---
const sections = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#education', label: 'Education and certification' },
  { href: '#contact', label: 'Contact' },
];
---

<button
  id="palette-open"
  type="button"
  class="tool-btn"
  aria-label="Jump to section"
>
  <span aria-hidden="true">⌘K</span>
</button>

<dialog id="palette" aria-label="Jump to section">
  <input id="palette-filter" type="text" placeholder="Jump to…" aria-label="Filter sections" autocomplete="off" />
  <ul id="palette-list">
    {
      sections.map((section) => (
        <li>
          <a href={section.href}>{section.label}</a>
        </li>
      ))
    }
  </ul>
</dialog>

<style>
  dialog {
    width: min(28rem, calc(100vw - 2rem));
    margin: 12vh auto auto;
    padding: 0.75rem;
    background: var(--bg-alt);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.6rem 0.75rem;
    font: inherit;
    color: inherit;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }
  a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    background: var(--bg);
    color: var(--accent);
  }
</style>

<script>
  const dialog = document.getElementById('palette') as HTMLDialogElement;
  const filter = document.getElementById('palette-filter') as HTMLInputElement;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#palette-list li'));

  const open = () => {
    filter.value = '';
    applyFilter();
    dialog.showModal();
    filter.focus();
  };

  const applyFilter = () => {
    const query = filter.value.trim().toLowerCase();
    items.forEach((item) => {
      item.hidden = !(item.textContent ?? '').toLowerCase().includes(query);
    });
  };

  const go = (link: HTMLAnchorElement | null | undefined) => {
    if (!link) return;
    dialog.close();
    location.hash = link.getAttribute('href') ?? '';
  };

  document.getElementById('palette-open')?.addEventListener('click', open);
  filter.addEventListener('input', applyFilter);
  filter.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      go(items.find((item) => !item.hidden)?.querySelector('a'));
    }
  });
  dialog.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest('a');
    if (link) {
      event.preventDefault();
      go(link);
    } else if (event.target === dialog) {
      dialog.close();
    }
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
</script>
